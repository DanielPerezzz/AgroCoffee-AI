POSTGRES_DB=agrocoffee
POSTGRES_USER=agrocoffee_user
POSTGRES_PASSWORD=change_me
SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
# Solo para demostraciones locales. En producción debe ser false.
PASSWORD_RESET_EXPOSE_CODE=true

# URL que se incorpora en la compilacion web del frontend Docker.
# En el navegador del equipo anfitrion, localhost apunta correctamente al backend.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
